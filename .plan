## 问题 2 解决：本地配置文件 + 手动下载脚本

### 方案 A：本地维护配置目录（推荐）

```
model_configs/
├── README.md              # 说明配置来源和更新方法
├── llama_3.1_8b.json
├── llama_3.1_70b.json
├── llama_3.1_405b.json
├── deepseek_v3.json
├── qwen3_30b_a3b.json
└── mixtral_8x7b.json
```

**model_configs/README.md:**
```markdown
# 模型配置文件

此目录维护主流开源 LLM 的 config.json，用于无需部署即可生成 workload。

## 配置来源

从 HuggingFace 模型仓库的 `config.json` 文件获取：
- Llama-3.1-8B: https://huggingface.co/meta-llama/Llama-3.1-8B/blob/main/config.json
- DeepSeek-V3: https://huggingface.co/deepseek-ai/DeepSeek-V3/blob/main/config.json
- ...

## 更新方法

1. 手动下载：访问上述链接，保存为 JSON
2. 批量下载：在有代理的环境执行 `bash scripts/download_model_configs.sh`
```

### 方案 B：手动下载脚本

```bash
# scripts/download_model_configs.sh
#!/bin/bash
set -e

MODELS=(
    "meta-llama/Llama-3.1-8B"
    "meta-llama/Llama-3.1-70B"
    "meta-llama/Llama-3.1-405B"
    "deepseek-ai/DeepSeek-V3"
    "Qwen/Qwen3-30B-A3B"
    "Qwen/Qwen2.5-72B"
    "mistralai/Mixtral-8x7B-v0.1"
)

OUTPUT_DIR="model_configs"
mkdir -p "$OUTPUT_DIR"

echo "📥 下载模型配置文件到 $OUTPUT_DIR/"
echo "⚠️  需要访问 HuggingFace，请确保网络畅通或配置代理"
echo ""

for model in "${MODELS[@]}"; do
    model_slug=$(echo "$model" | tr '/' '_' | tr '[:upper:]' '[:lower:]')
    output_file="$OUTPUT_DIR/${model_slug}.json"

    echo "➤ $model"

    # 使用 curl 下载（支持代理环境变量）
    if curl -fSL -o "$output_file" \
        "https://huggingface.co/$model/raw/main/config.json"; then
        echo "  ✅ $output_file"
    else
        echo "  ❌ 下载失败，跳过"
    fi
    echo ""
done

echo "✅ 下载完成！"
echo ""
echo "使用方法："
echo "  python -m workload_gen batch --config-dir model_configs/ --output baseline/cases/traced/"
```

### CLI 支持两种输入

```python
# workload_gen/cli.py

def cmd_generate(args):
    """生成单个模型的 workload"""

    # 输入方式 1：从本地 config 文件
    if args.config:
        with open(args.config) as f:
            config_dict = json.load(f)
        model_config = ModelConfig.from_dict(config_dict)
        if args.architecture:
            arch = ARCHITECTURE_REGISTRY[args.architecture]()
        else:
            arch_type = detect_architecture(config_dict)
            arch = ARCHITECTURE_REGISTRY[arch_type]()

    # 输入方式 2：从 HuggingFace（需要网络）
    elif args.model:
        # 尝试从 transformers 库加载
        try:
            from transformers import AutoConfig
            hf_config = AutoConfig.from_pretrained(args.model)
            config_dict = hf_config.to_dict()
            model_config = ModelConfig.from_dict(config_dict)
            arch_type = detect_architecture(config_dict)
            arch = ARCHITECTURE_REGISTRY[arch_type]()
        except Exception as e:
            print(f"❌ 无法从 HuggingFace 加载 {args.model}: {e}")
            print("💡 建议：先用 scripts/download_model_configs.sh 下载配置到本地")
            return 1

    # 生成 workload
    scenarios = generate_scenarios(args.scenarios)
    workload_sets = generate_workload_sets(model_config, arch, scenarios)
    export_yaml(workload_sets, args.output)


def cmd_batch(args):
    """批量生成多个模型的 workload"""
    config_dir = Path(args.config_dir)

    for config_file in config_dir.glob("*.json"):
        print(f"\n{'='*60}")
        print(f"  处理：{config_file.name}")
        print(f"{'='*60}")

        with open(config_file) as f:
            config_dict = json.load(f)

        model_config = ModelConfig.from_dict(config_dict)
        arch_type = detect_architecture(config_dict)
        arch = ARCHITECTURE_REGISTRY[arch_type]()

        scenarios = generate_scenarios(args.scenarios)
        workload_sets = generate_workload_sets(model_config, arch, scenarios)

        # 输出到 baseline/cases/traced/{model_name}/
        model_slug = config_file.stem
        output_dir = Path(args.output) / model_slug
        export_yaml(workload_sets, output_dir)

        print(f"✅ {len(workload_sets)} 个算子的 workload 已导出到 {output_dir}/")
```

