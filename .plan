# FlagOpBench 配置推导式 Workload 生成器设计方案（修订版）

## 核心思路

**从模型配置（config.json）推导所有算子的真实 shape**，无需部署模型。

```
本地模型配置 × 推理场景 → 算子 workload YAML
```

---

## 架构设计

```
workload_gen/
├── __init__.py
├── cli.py                    # CLI 入口
├── config.py                 # ModelConfig 数据类
├── transformer_template.py   # 统一 Transformer 模板（80% 通用逻辑）
├── architectures/            # 架构特化（20% 差异）
│   ├── __init__.py
│   ├── llama.py             # Llama 系列（GQA + Dense SwiGLU）
│   ├── mixtral.py           # Mixtral（GQA + MoE top-2）
│   ├── qwen_moe.py          # Qwen MoE（GQA + MoE top-8）
│   └── deepseek_v3.py       # DeepSeek-V3（MLA + MoE + Shared Expert）
├── scenario_generator.py     # 推理场景生成器
└── exporter.py               # WorkloadSet → YAML

model_configs/                # 本地维护的配置文件（无网络依赖）
├── llama_3.1_8b.json
├── llama_3.1_70b.json
├── deepseek_v3.json
├── qwen3_30b_a3b.json
└── mixtral_8x7b.json

scripts/
└── download_model_configs.sh # 从 HuggingFace 批量下载配置（你手动执行）
```

---

## 问题 1 解决：架构差异 = 统一模板 + 可配置变体

### 统一 Transformer 模板（`transformer_template.py`）

```python
@dataclass
class OperatorWorkload:
    """单个算子的 workload 记录"""
    op_name: str              # baseline 注册表中的算子名
    axes: dict[str, int]      # shape 参数
    const_params: dict        # 常量参数（dtype, eps, ...）
    source: str               # 来源标识


class TransformerLayerTemplate:
    """通用 Transformer 层模板（覆盖 80% 主流架构）"""

    def generate_layer_workloads(
        self,
        config: ModelConfig,
        scenario: InferenceScenario
    ) -> list[OperatorWorkload]:
        """生成单层的所有算子 workload"""
        workloads = []

        # 1. 输入归一化
        workloads.extend(self._norm_ops(config, scenario, "input"))

        # 2. Attention（子类实现差异：GQA/MLA/MHA）
        workloads.extend(self._attention_ops(config, scenario))

        # 3. Post-Attention 归一化
        workloads.extend(self._norm_ops(config, scenario, "post_attn"))

        # 4. FFN（子类实现差异：Dense/MoE）
        workloads.extend(self._ffn_ops(config, scenario))

        return workloads

    def _norm_ops(self, config, scenario, position) -> list[OperatorWorkload]:
        """归一化算子（通用）"""
        num_tokens = scenario.batch_size * scenario.seq_len
        return [OperatorWorkload(
            op_name="rms_norm",
            axes={"num_tokens": num_tokens, "hidden_size": config.hidden_size},
            const_params={"dtype": "bf16", "eps": 1e-5},
            source=f"{config.model_name}/layer_{position}/{scenario.phase}"
        )]

    def _attention_ops(self, config, scenario) -> list[OperatorWorkload]:
        """Attention 算子（子类覆盖）"""
        raise NotImplementedError("子类必须实现")

    def _ffn_ops(self, config, scenario) -> list[OperatorWorkload]:
        """FFN 算子（子类覆盖）"""
        raise NotImplementedError("子类必须实现")
```

### 架构特化实现（`architectures/llama.py`）

```python
class LlamaArchitecture(TransformerLayerTemplate):
    """Llama 系列：GQA + Dense SwiGLU FFN"""

    def _attention_ops(self, config, scenario) -> list[OperatorWorkload]:
        num_tokens = scenario.batch_size * scenario.seq_len
        head_dim = config.hidden_size // config.num_attention_heads

        workloads = []

        # QKV Projection
        kv_size = config.num_key_value_heads * head_dim
        qkv_size = config.num_attention_heads * head_dim + 2 * kv_size
        workloads.append(OperatorWorkload(
            op_name="mm",
            axes={"M": num_tokens, "K": config.hidden_size, "N": qkv_size},
            const_params={"dtype": "bf16"},
            source=f"llama/qkv_proj/{scenario.phase}"
        ))

        # RoPE
        workloads.append(OperatorWorkload(
            op_name="rope",
            axes={
                "batch": scenario.batch_size,
                "seq_len": scenario.seq_len,
                "num_heads": config.num_attention_heads,
                "head_dim": head_dim
            },
            const_params={"dtype": "bf16"},
            source=f"llama/rope/{scenario.phase}"
        ))

        # Attention Core
        if scenario.phase == "prefill":
            workloads.append(OperatorWorkload(
                op_name="flash_attention",
                axes={
                    "batch": scenario.batch_size,
                    "seq_len": scenario.seq_len,
                    "num_heads": config.num_attention_heads,
                    "head_dim": head_dim
                },
                const_params={"dtype": "bf16", "causal": True},
                source="llama/attention_prefill"
            ))
        else:  # decode
            workloads.append(OperatorWorkload(
                op_name="paged_attention_decode",
                axes={
                    "batch": scenario.batch_size,
                    "num_qo_heads": config.num_attention_heads,
                    "num_kv_heads": config.num_key_value_heads,
                    "head_dim": head_dim,
                    "kv_len": scenario.kv_len
                },
                const_params={"dtype": "bf16"},
                source="llama/attention_decode"
            ))

        # O Projection
        workloads.append(OperatorWorkload(
            op_name="mm",
            axes={"M": num_tokens, "K": config.hidden_size, "N": config.hidden_size},
            const_params={"dtype": "bf16"},
            source=f"llama/o_proj/{scenario.phase}"
        ))

        return workloads

    def _ffn_ops(self, config, scenario) -> list[OperatorWorkload]:
        """Dense SwiGLU FFN"""
        num_tokens = scenario.batch_size * scenario.seq_len

        return [
            # Gate + Up Projection (fused)
            OperatorWorkload(
                op_name="mm",
                axes={"M": num_tokens, "K": config.hidden_size, "N": config.intermediate_size * 2},
                const_params={"dtype": "bf16"},
                source=f"llama/gate_up_proj/{scenario.phase}"
            ),
            # SiLU and Mul
            OperatorWorkload(
                op_name="silu_and_mul",
                axes={"M": num_tokens, "N": config.intermediate_size},
                const_params={"dtype": "bf16"},
                source=f"llama/swiglu/{scenario.phase}"
            ),
            # Down Projection
            OperatorWorkload(
                op_name="mm",
                axes={"M": num_tokens, "K": config.intermediate_size, "N": config.hidden_size},
                const_params={"dtype": "bf16"},
                source=f"llama/down_proj/{scenario.phase}"
            )
        ]


class MixtralArchitecture(TransformerLayerTemplate):
    """Mixtral：GQA + MoE (top-2, 8 experts)"""

    def _attention_ops(self, config, scenario):
        # 与 Llama 完全相同
        return LlamaArchitecture()._attention_ops(config, scenario)

    def _ffn_ops(self, config, scenario):
        """MoE FFN"""
        num_tokens = scenario.batch_size * scenario.seq_len

        return [
            # Router (gating)
            OperatorWorkload(
                op_name="mm",
                axes={"M": num_tokens, "K": config.hidden_size, "N": config.num_experts},
                const_params={"dtype": "bf16"},
                source=f"mixtral/moe_gate/{scenario.phase}"
            ),
            # TopK selection
            OperatorWorkload(
                op_name="topk_selector",
                axes={"num_tokens": num_tokens, "num_experts": config.num_experts, "top_k": config.num_experts_per_tok},
                const_params={"dtype": "bf16"},
                source=f"mixtral/moe_topk/{scenario.phase}"
            ),
            # Expert computation (fused MoE kernel)
            OperatorWorkload(
                op_name="fused_moe",
                axes={
                    "num_tokens": num_tokens,
                    "hidden_size": config.hidden_size,
                    "expert_size": config.moe_intermediate_size,
                    "num_experts": config.num_experts,
                    "top_k": config.num_experts_per_tok
                },
                const_params={"dtype": "bf16"},
                source=f"mixtral/fused_moe/{scenario.phase}"
            )
        ]


# 架构注册表
ARCHITECTURE_REGISTRY = {
    "llama": LlamaArchitecture,
    "mixtral": MixtralArchitecture,
    # P2 添加：
    # "qwen_moe": QwenMoeArchitecture,
    # "deepseek_v3": DeepSeekV3Architecture,
}
```

### 架构自动检测

```python
def detect_architecture(config_dict: dict) -> str:
    """从 config.json 自动识别架构"""
    arch_type = config_dict.get("architectures", [""])[0].lower()

    if "llama" in arch_type:
        if config_dict.get("num_experts"):
            return "qwen_moe"  # Qwen MoE 用的是 Llama 变体
        return "llama"

    if "mixtral" in arch_type:
        return "mixtral"

    if "deepseek" in arch_type and config_dict.get("q_lora_rank"):
        return "deepseek_v3"

    # 默认回退到 Llama
    return "llama"
```

